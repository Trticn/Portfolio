---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
}

const { href, type = "button", class: className = "" } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  type={href ? undefined : type}
  data-venom
  class:list={[
    "group inline-flex items-center gap-2.5 rounded-full bg-accent py-2.5 pr-2.5 pl-5.5 text-sm font-semibold text-white transition-colors duration-300 ease-smooth hover:bg-accent/90 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-accent md:py-2.75 md:pl-6 md:text-base",
    className,
  ]}
>
  <slot />
  <span class="venom-face size-7.5 md:size-8.5">
    <span class="venom-ball flex size-full shrink-0 items-center justify-center rounded-full" data-venom-ball>
      <span class="venom-iris transition-[translate] duration-400 ease-smooth group-focus-visible:translate-x-0.5 group-focus-visible:-translate-y-0.5 motion-reduce:transition-none" data-venom-iris aria-hidden="true">
        <svg class="venom-eye" viewBox="0 0 40 18">
          <path fill="#ffffff" d="M1 9C5 3 11 2 18 4.5L37 9 18 13.5C11 16 5 15 1 9Z"></path>
        </svg>
        <span class="venom-eye-scale" data-venom-pupil></span>
      </span>
    </span>
  </span>
</Tag>
