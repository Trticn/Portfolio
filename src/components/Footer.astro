---
import { site } from "../data/site";
---

<footer class="border-t border-white/10 px-6 py-8 md:px-12">
  <div class="mx-auto flex max-w-[1400px] flex-col gap-3 md:flex-row md:items-center md:justify-between">
    <p class="text-sm leading-6 text-muted">
      <span class="text-white/90">© 2026 {site.name}</span>
      <span class="mx-2 hidden text-white/30 md:inline" aria-hidden="true">·</span>
      <span class="mt-0.5 block text-white/55 md:mt-0 md:inline">All rights reserved</span>
    </p>
  </div>
</footer>
