---
import { site } from "../data/site";
import Button from "./Button.astro";
---

<section id="about" class="band px-6 md:px-12">
  <div class="mx-auto max-w-[1280px]">
    <h2 class="display-title mb-6 font-display text-[clamp(3.15rem,14vw,4rem)] leading-[0.95] text-balance uppercase md:mb-8 md:text-[clamp(6.5rem,14vw,12.5rem)] md:leading-[1.2]">
      About Me
    </h2>
    <div class="grid lg:grid-cols-3 lg:gap-8">
      <div class="rise max-w-[52rem] lg:col-span-2 lg:col-start-2">
        <p class="flex items-center gap-2 text-xs uppercase tracking-[3px] text-muted">
          <span class="size-2 rounded-full bg-accent" aria-hidden="true"></span>
          Who I am
        </p>
        <p class="mt-4 text-xl leading-[1.6] text-pretty text-white md:text-2xl">
          {site.about}
        </p>
        <Button href="#projects" class="mt-12 md:mt-16">View Projects</Button>
      </div>
    </div>
  </div>
</section>
