---
import { site } from "../data/site";
import Button from "./Button.astro";
---

<section id="home" class="relative flex min-h-svh flex-col overflow-hidden">
  <div class="hero-light pointer-events-none absolute inset-0"></div>
  <canvas data-web class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true"></canvas>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-ink via-ink/55 to-transparent"></div>

  {
    site.heroImage && (
      <figure class="hero-portrait">
        <img src={site.heroImage} alt={site.name} width="720" height="960" fetchpriority="high" decoding="async" />
      </figure>
    )
  }
  <canvas data-drop class="pointer-events-none absolute inset-0 z-[6] h-full w-full" aria-hidden="true"></canvas>

  <div class="rise-load relative z-10 mt-auto flex w-full flex-col items-center px-6 pb-16 text-center md:pb-20 lg:pb-24">
    <p class="eyebrow justify-center md:text-[0.85rem] md:tracking-[0.22em]">{site.availability}</p>
    <p class="mt-6 max-w-sm text-balance text-[0.7rem] uppercase tracking-[0.18em] text-white/80 sm:max-w-none sm:tracking-[0.24em] md:mt-7 md:text-[0.95rem] md:tracking-[0.2em]">
      {site.name} · {site.role}
    </p>
    <h1 class="mt-5 font-display text-[clamp(3.6rem,8vw,7.5rem)] leading-[1.1] text-balance">
      {site.headline}
    </h1>
    <Button href="#contact" class="mt-10">Let's talk</Button>
  </div>
</section>

<script>
  import "../scripts/hero-web";
</script>
